{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.prod*)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/gcp-sa-key.json)",
      "Read(./**/*service-account*.json)",
      "Edit(./**/*.jks)",
      "Edit(./**/*.keystore)"
    ],
    "ask": [
      "Read(./**/local.properties)",
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "Bash(git filter-repo *)",
      "Bash(git filter-branch *)",
      "Bash(gcloud run deploy *)",
      "Bash(gcloud builds submit *)",
      "Bash(gcloud sql *)",
      "Bash(gcloud secrets *)",
      "Bash(docker push *)",
      "Bash(firebase deploy *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" --fail-closed guard.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" post_edit.py",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.sh\" stop_gate.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
