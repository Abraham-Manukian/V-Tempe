-- Workout and WorkoutSet tables
CREATE TABLE Workout(
  id TEXT NOT NULL PRIMARY KEY,
  weekIndex INTEGER NOT NULL,
  label TEXT NOT NULL DEFAULT '',
  date TEXT NOT NULL -- ISO-8601 LocalDate
);

CREATE TABLE WorkoutSet(
  workoutId TEXT NOT NULL REFERENCES Workout(id) ON DELETE CASCADE,
  exerciseId TEXT NOT NULL,
  reps INTEGER NOT NULL,
  weightKg REAL,
  rpe REAL,
  sets INTEGER NOT NULL DEFAULT 3,
  restSeconds INTEGER,
  unit TEXT,
  bodyweight INTEGER
);

CREATE INDEX IF NOT EXISTS idx_workout_week ON Workout(weekIndex);
CREATE INDEX IF NOT EXISTS idx_set_workout ON WorkoutSet(workoutId);

selectAllWorkouts:
SELECT * FROM Workout ORDER BY date;

insertWorkout:
INSERT OR REPLACE INTO Workout(id, weekIndex, label, date) VALUES (?, ?, ?, ?);

deleteWorkout:
DELETE FROM Workout WHERE id = ?;

deleteWorkoutsByWeek:
DELETE FROM Workout WHERE weekIndex = ?;

insertSet:
INSERT INTO WorkoutSet(workoutId, exerciseId, reps, weightKg, rpe, sets, restSeconds, unit, bodyweight) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteSetsForWorkout:
DELETE FROM WorkoutSet WHERE workoutId = ?;

selectWorkoutsWithSets:
SELECT w.id, w.label, w.date, s.exerciseId, s.reps, s.weightKg, s.rpe, s.sets, s.restSeconds, s.unit, s.bodyweight
FROM Workout w
LEFT JOIN WorkoutSet s ON s.workoutId = w.id
ORDER BY w.date;

selectWorkoutsWithSetsByWeek:
SELECT w.id, w.label, w.date, s.exerciseId, s.reps, s.weightKg, s.rpe, s.sets, s.restSeconds, s.unit, s.bodyweight
FROM Workout w
LEFT JOIN WorkoutSet s ON s.workoutId = w.id
WHERE w.weekIndex = ?
ORDER BY w.date;

deleteSetsByWeek:
DELETE FROM WorkoutSet WHERE workoutId IN (SELECT id FROM Workout WHERE weekIndex = ?);

-- Foreign keys are not enabled on this database, so ON DELETE CASCADE never fires: every delete
-- of Workout rows removes their WorkoutSet rows explicitly (as Nutrition.sq does for meals).
deleteAllSets:
DELETE FROM WorkoutSet;

deleteAllWorkouts:
DELETE FROM Workout;

deleteSetsFromWeek:
DELETE FROM WorkoutSet WHERE workoutId IN (SELECT id FROM Workout WHERE weekIndex >= ?);

-- Deletes plan workouts for all weeks >= given index (delete their sets first: deleteSetsFromWeek).
-- Used when profile changes to invalidate stale pre-fetched future weeks.
deleteWorkoutsFromWeek:
DELETE FROM Workout WHERE weekIndex >= ?;

-- Sets left behind by earlier versions, which relied on the cascade.
deleteOrphanSets:
DELETE FROM WorkoutSet WHERE workoutId NOT IN (SELECT id FROM Workout);
